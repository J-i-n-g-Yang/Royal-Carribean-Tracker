# ── Secrets — never commit these ─────────────────────────────────────────────
backend/secrets/*
!backend/secrets/*.example.json
.env
*.env
.env.*

# ── Runtime data (personal run history, regenerated on first check) ─────────
backend/data/*
!backend/data/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/build/
frontend/.env*
npm-debug.log*
yarn-error.log*

# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
